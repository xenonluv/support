# 줄바꿈을 LF로 통일 (Windows·Mac·Vercel 공통)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

