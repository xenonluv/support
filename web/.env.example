# 이 파일을 복사해 .env.local로 쓴다. .env.local은 git에 올리지 않는다.
# 운영 값은 Vercel 환경변수에 있다. 민감 정보(비밀 키)는 vercel env pull로 내려오지 않으므로 직접 넣는다.

# 브라우저에 노출되는 값 — NEXT_PUBLIC_은 이 두 개에만 쓴다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_을 붙이지 않는다
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# 로컬 관리 스크립트용 (npm run seed / test:rls)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
TEST_MANAGER_A_EMAIL=
TEST_MANAGER_A_PASSWORD=
TEST_WORKER_A_EMAIL=
TEST_WORKER_A_PASSWORD=
TEST_WORKER_B_EMAIL=
TEST_WORKER_B_PASSWORD=

# 웹푸시 (npx web-push generate-vapid-keys). 공개키는 서버 화면이 버튼으로 넘긴다 — NEXT_PUBLIC_ 아님
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://dolbomieum.kr
