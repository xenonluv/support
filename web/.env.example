# 이 파일을 복사해 .env.local로 쓴다. .env.local은 git에 올리지 않는다.
# 운영 값은 Vercel 환경변수에 넣고, 다른 컴퓨터에서는 `vercel env pull`로 받는다.

# 브라우저에 노출되는 값 — NEXT_PUBLIC_은 이 두 개에만 쓴다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_을 붙이지 않는다
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
